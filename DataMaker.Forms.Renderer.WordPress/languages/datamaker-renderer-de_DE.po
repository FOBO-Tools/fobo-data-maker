msgid "Data Maker Forms"
msgstr "Data Maker Formulare"

#. Plugin URI of the plugin
#: datamaker-renderer.php
msgid "https://fobo-tools.com/"
msgstr ""

#. Description of the plugin
#: datamaker-renderer.php
msgid "Renders Data Maker forms from signed .dmf uploads. POSTs sealed submissions to the Data Maker API; supports the localStorage-backed edit flow."
msgstr "Stellt Data-Maker-Formulare aus signierten .dmf-Uploads dar. Sendet versiegelte Übermittlungen an die Data-Maker-API; unterstützt den auf localStorage basierenden Bearbeitungsablauf."

#. Author of the plugin
#: datamaker-renderer.php
msgid "FOBO"
msgstr ""

