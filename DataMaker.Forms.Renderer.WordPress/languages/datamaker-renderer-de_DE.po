#: includes/Admin/SettingsPage.php:74
msgid "Data Maker Forms — Settings"
msgstr "Data Maker Formulare — Einstellungen"

#: includes/Admin/SettingsPage.php:79
msgid "Signature verification"
msgstr "Signaturprüfung"

#: includes/Admin/SettingsPage.php:83
msgid "Require uploaded .dmf bundles to be Ed25519-signed"
msgstr "Hochgeladene .dmf-Bundles müssen Ed25519-signiert sein"

#: includes/Admin/SettingsPage.php:87
msgid "base64-encoded signer pubkey (optional)"
msgstr "Base64-codierter öffentlicher Signaturschlüssel (optional)"

#: includes/Admin/SettingsPage.php:88
msgid "If set, the uploaded .dmf must be signed with exactly this pubkey. Leave blank to accept any signed bundle."
msgstr "Wenn festgelegt, muss die hochgeladene .dmf genau mit diesem öffentlichen Schlüssel signiert sein. Leer lassen, um jedes signierte Bundle zu akzeptieren."

#. translators: %s = link to cloudflare.com/turnstile
#: includes/Admin/SettingsPage.php:97
#, php-format
msgid "Privacy-friendly CAPTCHA challenge. Enroll for free at %s; paste the site & secret keys here. Each form chooses whether to require it via Form Settings."
msgstr "Datenschutzfreundliche CAPTCHA-Aufgabe. Melden Sie sich kostenlos bei %s an; fügen Sie hier den Site- und den geheimen Schlüssel ein. Jedes Formular entscheidet über seine Einstellungen, ob es erforderlich ist."

#: includes/Admin/SettingsPage.php:103
msgid "Site key"
msgstr "Site-Schlüssel"

#: includes/Admin/SettingsPage.php:107
msgid "Public key embedded in the form page (data-sitekey)."
msgstr "Öffentlicher Schlüssel, der in die Formularseite eingebettet wird (data-sitekey)."

#: includes/Admin/SettingsPage.php:111
msgid "Secret key"
msgstr "Geheimer Schlüssel"

#: includes/Admin/SettingsPage.php:115
msgid "Used server-side to verify tokens with Cloudflare. Never sent to the browser."
msgstr "Wird serverseitig verwendet, um Tokens bei Cloudflare zu überprüfen. Wird nie an den Browser gesendet."

#: includes/Admin/UploadPage.php:28
msgid "Forms"
msgstr "Formulare"

#: includes/Admin/UploadPage.php:43
