#: includes/Admin/SettingsPage.php:79
msgid "Signature verification"
msgstr "Vérification de signature"

#: includes/Admin/SettingsPage.php:83
msgid "Require uploaded .dmf bundles to be Ed25519-signed"
msgstr "Exiger que les fichiers .dmf téléversés soient signés en Ed25519"

#: includes/Admin/SettingsPage.php:87
msgid "base64-encoded signer pubkey (optional)"
msgstr "clé publique du signataire encodée en base64 (facultatif)"

#: includes/Admin/SettingsPage.php:88
msgid "If set, the uploaded .dmf must be signed with exactly this pubkey. Leave blank to accept any signed bundle."
msgstr "Si défini, le .dmf téléversé doit être signé avec exactement cette clé publique. Laissez vide pour accepter tout fichier signé."

#. translators: %s = link to cloudflare.com/turnstile
#: includes/Admin/SettingsPage.php:97
#, php-format
msgid "Privacy-friendly CAPTCHA challenge. Enroll for free at %s; paste the site & secret keys here. Each form chooses whether to require it via Form Settings."
msgstr "Défi CAPTCHA respectueux de la vie privée. Inscrivez-vous gratuitement sur %s ; collez ici les clés de site et secrète. Chaque formulaire choisit de l’exiger ou non via ses réglages."

#: includes/Admin/SettingsPage.php:103
msgid "Site key"
msgstr "Clé de site"

#: includes/Admin/SettingsPage.php:107
msgid "Public key embedded in the form page (data-sitekey)."
msgstr "Clé publique intégrée dans la page du formulaire (data-sitekey)."

#: includes/Admin/SettingsPage.php:111
msgid "Secret key"
msgstr "Clé secrète"

#: includes/Admin/SettingsPage.php:115
msgid "Used server-side to verify tokens with Cloudflare. Never sent to the browser."
msgstr "Utilisée côté serveur pour vérifier les jetons auprès de Cloudflare. Jamais envoyée au navigateur."

