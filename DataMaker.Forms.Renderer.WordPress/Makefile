PLUGIN     := datamaker-renderer
VERSION    := $(shell awk -F"'" '/DM_RENDERER_VERSION/{print $$4}' datamaker-renderer.php)
RENDERER_SRC := ../DataMaker.Forms.Renderer.Web/wwwroot
DIST       := dist
ZIP        := $(DIST)/$(PLUGIN)-$(VERSION).zip
# Minified assets live in assets/dist/ — gitignored. Generated by `make
# minify`; the shortcode prefers the .min.* file when present and
# WP_DEBUG is off. Pinned versions so a `make minify` six months from
# now produces byte-identical output (and so a Cloudflare-edge cache
# bust matches what was tested).
MIN_DIR    := assets/dist
TERSER_VER := 5.36.0
CSSO_VER   := 4.0.2
NODE_IMG   := node:20-alpine
WPCLI_IMG  := wordpress:cli-php8.2
TWEETNACL_VER := 1.0.3
SEALEDBOX_VER := 1.0.0
ESBUILD_VER   := 0.21.5

.PHONY: sync-assets minify vendor-crypto package pot mo json clean check up down logs wp-shell wp-install

# Bundle the browser sealed-box (tweetnacl + tweetnacl-sealedbox-js) used to
# E2E-encrypt blob bytes before the direct-to-S3 PUT (#45). esbuild produces a
# single IIFE that assigns window.DataMakerBlobCrypto. Pinned versions so the
# committed bundle is reproducible. Output is checked in (not gitignored) so a
# plain checkout ships a working plugin without a build step.
vendor-crypto:
	@mkdir -p assets/vendor
	docker run --rm -v "$(CURDIR)":/work -w /work $(NODE_IMG) sh -lc '\
	  set -e; \
	  npm install --silent --no-fund --no-audit --prefix /tmp/bc \
	      tweetnacl@$(TWEETNACL_VER) tweetnacl-sealedbox-js@$(SEALEDBOX_VER) esbuild@$(ESBUILD_VER) >/dev/null; \
	  NODE_PATH=/tmp/bc/node_modules /tmp/bc/node_modules/.bin/esbuild assets/src/dm-blob-crypto.js \
	      --bundle --minify --format=iife --outfile=assets/vendor/dm-blob-crypto.min.js; \
	'
	@echo "Built assets/vendor/dm-blob-crypto.min.js"

sync-assets:
	cp $(RENDERER_SRC)/renderer.js       assets/renderer.js
	cp $(RENDERER_SRC)/fn.js             assets/fn.js
	cp $(RENDERER_SRC)/fa-solid-900.ttf  assets/fa-solid-900.ttf
	cp $(RENDERER_SRC)/layout.css        assets/layout.css
	cp $(RENDERER_SRC)/styles.css        assets/styles.css
	# C# WebRenderer substitutes __FA_SOLID_DATA_URI__ with a base64
	# data: URI at render time so the WebView2 page is fully self-contained.
	# WP loads styles.css as a static file, so the substitution never runs —
	# rewrite the placeholder to a relative URL pointing at the ttf we just
	# copied alongside the stylesheet.
	@sed -i.bak 's|__FA_SOLID_DATA_URI__|fa-solid-900.ttf|g' assets/styles.css && rm assets/styles.css.bak
	@echo "Synced renderer assets from $(RENDERER_SRC)"

minify: sync-assets
	@mkdir -p $(MIN_DIR)
	@docker run --rm -v "$(CURDIR)":/work -w /work $(NODE_IMG) sh -lc '\
	  set -e; \
	  npm install --silent --no-fund --no-audit --prefix /tmp/min \
	      terser@$(TERSER_VER) csso-cli@$(CSSO_VER) >/dev/null; \
	  TERSER=/tmp/min/node_modules/.bin/terser; \
	  CSSO=/tmp/min/node_modules/.bin/csso; \
	  for f in renderer.js wp-bridge.js fn.js; do \
	    $$TERSER assets/$$f --compress --mangle --output $(MIN_DIR)/$${f%.js}.min.js; \
	  done; \
	  for f in layout.css styles.css; do \
	    $$CSSO assets/$$f --output $(MIN_DIR)/$${f%.css}.min.css; \
	  done; \
	'
	# styles.css references `fa-solid-900.ttf` with a CSS-relative
	# `url(...)`. Source CSS lives at /assets/, font sits next to it,
	# resolves fine. Minified CSS lives at /assets/dist/, font does NOT
	# get copied there — rewrite the URL to step one folder up so the
	# font resolves from the dist/ location too.
	@sed -i.bak 's|url(fa-solid-900.ttf)|url(../fa-solid-900.ttf)|g' $(MIN_DIR)/styles.min.css && rm $(MIN_DIR)/styles.min.css.bak
	@echo "Minified → $(MIN_DIR)/"
	@ls -lh $(MIN_DIR)/

package: minify
	@mkdir -p $(DIST)
	@rm -f $(ZIP)
	# Stage into a folder named after the plugin so WP installer unpacks
	# into wp-content/plugins/datamaker-renderer/.
	@rm -rf $(DIST)/staging && mkdir -p $(DIST)/staging/$(PLUGIN)
	@cp -R datamaker-renderer.php includes assets languages readme.txt $(DIST)/staging/$(PLUGIN)/
	cd $(DIST)/staging && zip -r ../../$(ZIP) $(PLUGIN) >/dev/null
	@rm -rf $(DIST)/staging
	@echo "Built $(ZIP)"

# ── Translations (gettext) ─────────────────────────────────────────────
# `make pot` re-extracts every __()/_e()/esc_html__()/_n() call (PHP) and
# every block-editor __() (assets/block.js) into languages/$(PLUGIN).pot
# via WP-CLI's i18n command (no WP install needed — make-pot is a
# standalone source scan). `make mo` compiles each languages/*.po into its
# .mo sibling (PHP gettext); `make json` splits the JS-sourced strings out
# of each .po into the md5-named .json WordPress loads for the block-editor
# script handle (wp_set_script_translations). vendor/, tests/, dist/, the
# minified bundle, and the big generated renderer assets (no gettext calls)
# are excluded so only first-party plugin strings land in the pot.
pot:
	docker run --rm -v "$(CURDIR)":/app -w /app $(WPCLI_IMG) \
		wp i18n make-pot . languages/$(PLUGIN).pot \
		--domain=$(PLUGIN) \
		--exclude=vendor,tests,dist,assets/dist,assets/renderer.js,assets/fn.js,assets/wp-bridge.js \
		--allow-root
	@echo "Extracted languages/$(PLUGIN).pot"

mo:
	docker run --rm -v "$(CURDIR)":/app -w /app $(WPCLI_IMG) sh -lc '\
		for po in languages/*.po; do \
			[ -f "$$po" ] || continue; \
			wp i18n make-mo "$$po" "$${po%.po}.mo" --allow-root; \
		done'
	@echo "Compiled languages/*.mo"

json:
	docker run --rm -v "$(CURDIR)":/app -w /app $(WPCLI_IMG) \
		wp i18n make-json languages --no-purge --pretty-print --allow-root
	@echo "Generated languages/*.json (block-editor JS)"

check:
	@php -l datamaker-renderer.php
	@find includes -name '*.php' -print -exec php -l {} \;

clean:
	rm -rf $(DIST)

# ── Local Docker WordPress harness ─────────────────────────────────────
# `make up` starts WP on http://localhost:8089. First boot: complete the
# install wizard, then activate "DataMaker Renderer" under Plugins.

up:
	docker compose up -d
	@echo "WordPress booting on http://localhost:8089 — give it ~10s on first run."

down:
	docker compose down

logs:
	docker compose logs -f wordpress

# Drop into the WP container for ad-hoc commands.
wp-shell:
	docker compose exec wordpress bash

# One-shot scripted install via WP-CLI (idempotent). Picks user admin / pw admin.
wp-install:
	docker compose exec -T wordpress bash -lc '\
		apt-get update >/dev/null && apt-get install -y --no-install-recommends less >/dev/null; \
		curl -sS -o /usr/local/bin/wp https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar && chmod +x /usr/local/bin/wp; \
		wp core install --url=http://localhost:8089 --title="DataMaker Renderer Dev" \
			--admin_user=admin --admin_password=admin --admin_email=admin@example.com --skip-email --allow-root || true; \
		wp plugin activate datamaker-renderer --allow-root; \
	'
