<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>

    <!-- Shared client-subset SDK package: the expression engine + Fn library
         (same logic the JS renderer ships as fn.js). Note: DynamicExpresso is
         trim-unfriendly, so trimmed/single-file consumers must root this. -->
    <IsPackable>true</IsPackable>
    <PackageId>DataMaker.Expressions</PackageId>
    <Version>0.1.0</Version>
    <Authors>FOBO Tools</Authors>
    <Description>Data Maker expression engine and Fn function library for calculated fields, conditional visibility, and validation. Shared by the app, renderers, and client SDKs.</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DataMaker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DynamicExpresso.Core" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
