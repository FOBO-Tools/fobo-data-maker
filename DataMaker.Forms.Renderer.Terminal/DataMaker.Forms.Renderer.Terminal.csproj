<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>DataMaker.Forms.Renderer.Terminal</RootNamespace>
    <AssemblyName>datamaker-form</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Distributable single-binary publish settings.
       SCD + single-file gives us a no-runtime-required exe;
       trim + R2R cuts the per-platform size dramatically.
       Conversion of every JSON serializer to source-generated
       JsonSerializerContext (in this same csproj sweep) is what
       keeps trimming safe — without that, JsonSerializer.Deserialize<T>
       silently breaks under trim. -->
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;win-x64</RuntimeIdentifiers>
    <PublishTrimmed>true</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
    <TrimMode>partial</TrimMode>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FOBO.Auth\FOBO.Auth.csproj" />
    <ProjectReference Include="..\DataMaker.Expressions\DataMaker.Expressions.csproj" />
    <!-- Storage-free evaluator only — the terminal uses FormEvaluator, not the
         storage-coupled FormInstance, so it doesn't reference Forms.Runtime
         (and ships no server store interfaces). -->
    <ProjectReference Include="..\DataMaker.Forms.Evaluation\DataMaker.Forms.Evaluation.csproj" />
    <!-- Verify-only — the terminal loads + verifies .dmf bundles but never
         signs or generates keys, so it references the verify assembly and
         ships none of the signing/keygen surface. -->
    <ProjectReference Include="..\DataMaker.Forms.Signing.Verify\DataMaker.Forms.Signing.Verify.csproj" />
    <ProjectReference Include="..\DataMaker.Schema\DataMaker.Schema.csproj" />
    <!-- Submit path goes through the public client SDK, not server internals,
         so the terminal ships only the SDK subset (no DataMaker.Sync.Shared). -->
    <ProjectReference Include="..\DataMaker.Sdk.Net\src\DataMaker.Sdk\DataMaker.Sdk.csproj" />
  </ItemGroup>

</Project>
