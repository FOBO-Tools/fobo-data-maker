{
  "name": "fobo/datamaker-sdk",
  "description": "Sender-side SDK for DataMaker forms: read a .dmf, verify the signature + FOBO attestation, sealed-box encrypt a submission, and POST it.",
  "type": "library",
  "license": "BSD-3-Clause",
  "keywords": ["datamaker", "fobo", "forms", "e2ee", "sealed-box"],
  "require": {
    "php": ">=8.0",
    "ext-sodium": "*",
    "ext-zip": "*",
    "ext-json": "*",
    "ext-curl": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5 || ^10.0"
  },
  "autoload": {
    "psr-4": { "DataMaker\\Sdk\\": "src/" },
    "files": ["src/Errors.php"]
  },
  "autoload-dev": {
    "psr-4": { "DataMaker\\Sdk\\Tests\\": "tests/" }
  }
}
